<?xml version="1.0" encoding="utf-8"?>
<!-- Roehens keeps camera addresses, settings and the credential vault on the
     phone only. Nothing goes to cloud backup or to a new phone by device
     transfer; the person exports a camera list on purpose when they want one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
